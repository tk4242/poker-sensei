# コピーして使う: cp .env.example .env && chmod 600 .env   （.env は Git に入れない）
# VPS に向けたドメイン（DNS の A レコードを VPS の IP に）
DOMAIN=poker.example.com
# ランダムな長い文字列: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
APP_USER=koja
# 12文字以上。平文が嫌なら APP_PASSWORD を消して APP_PASSWORD_HASH を使う（python -m sensei hash-password）
APP_PASSWORD=
# APP_PASSWORD_HASH=
# 任意: AIコーチ（Anthropic API の従量課金）
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-5-5
# COACH_EFFORT=medium
